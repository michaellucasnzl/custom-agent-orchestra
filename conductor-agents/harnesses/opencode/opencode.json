{
  "agents": {
    "directory": ".opencode/agent"
  },
  "permissions": {
    "default": {
      "edit": "ask",
      "bash": "ask",
      "webfetch": "ask"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    }
  }
  
}
